
#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

/* Faça um rograma que carregue um vetor e 9 elementos numericos inteiros, calcule e mostre os numero primos e suas respectivas posicoes*/

int main(int argc, char *argv[]) {
	
	setlocale(LC_ALL, "Portuguese");
	
    int vet[9], i, j, cont;

	for(i=0;i<=9;i++){
		printf("Digite um numero inteiro: \n");
    	scanf("%d", &vet[i]);
	}
	for(i=0;i<=9;i++){
	    cont = 0;
	    for (j = 1; j <= vet[i]; j++) {
	        if (vet[i] % j == 0) {
	            cont++;
	        }
	    }
	
	    if (cont == 2) {
	        printf("O %d é um numero primo,posicao %d \n", vet[i], i);
	    } else {
	        printf("O %d não é um numero primo posicao %d \n", vet[i], i);
	    }
	}
}
