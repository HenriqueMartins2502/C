
#include <stdio.h>
#include <stdlib.h>

/* Pedro comprou um saco de ração para seus
gatos, com o peso em quilos. Faça uma função que receba o peso do saco de ração, em
quilos, o número de gatos e a quantidade de ração fornecida para cada gato por dia, em
gramas. A função deve retornar o total de quilos de ração restante no saco, após um dia
de consumo. Assim sendo, considerando que Pedro possui dois gatos, crie um algoritmo
que invoque a função recém criada para calcular e mostrar quanto restará de ração no
saco após cinco dias.) */

float TotalRestante(float peso, float gatos, float qntd_fornecida){
	float qntd_restante_saco;
	qntd_restante_saco = peso - (qntd_fornecida / 1000) * gatos * 5;
	return qntd_restante_saco;
}

int main(int argc, char *argv[]) {
	float peso_rac,num_gatos,qntd_rac_dia,dias;
	
	printf("Digite o peso da racao em quilos: \n");
	scanf("%f", &peso_rac);
	printf("Digite o numero de gatos: \n");
	scanf("%f", &num_gatos);
	printf("Digite a quantidade de racao fornecida para cada gato por dia em gramas: \n");
	scanf("%f", &qntd_rac_dia);
	
	dias = TotalRestante(peso_rac, num_gatos, qntd_rac_dia);
	printf("A qntd em quilos apos cinco dias: %.2f kg \n", dias);
}
