#include <stdio.h>
#include <stdlib.h>

/* 	Sabe-se que:
1 pé = 12 polegadas;
1 jarda = 3 pés;
1 milha = 1760 jardas;
Faça um programa que receba uma medida em pés, faça as conversões a seguir e mostre
os resultados.
a) polegadas;
b) jardas;
c) milhas. */

void Calculo(int med_pe,int *pol, int *jardas, int *milhas){
	(*pol) = med_pe * 12;
	(*jardas) = med_pe / 3;
	(*milhas) = med_pe / (1760 * 3);
}

int main(int argc, char *argv[]) {
	
	int med_pe,resp1,resp2,resp3;
	
	printf("Digite uma medida em pes: \n");
	scanf("%d", &med_pe);
	
	Calculo(med_pe,&resp1,&resp2,&resp3);
	printf("Valor em polegadas: %d \n", resp1);
	printf("Valor em jardas: %d \n", resp2);
	printf("Valor em milhas: %d \n", resp3);
	
}
