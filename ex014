#include <stdio.h>
#include <stdlib.h>

/* Desenvolva um algoritmo que peça ao usuário que informe os coeficientes a, b e c de 
uma equação de segundo grau: ax² + bx + c. Com base na Fórmula de Bhaskara, calcule 
e mostre as raízes da respectiva equação de segundo grau */

void EqSegundoGrau(int a, int b, int c, int *y, int *x1, int *x2){
	(*y) = (b*b) - 4 * a * c;
	(*x1) = -b + (*y) / (2 * a);
	(*x2) = -b - (*y) / (2 * a);
}

int main(int argc, char *argv[]) {

	int a,b,c,y,resp1,resp2;
	
	printf("Digite o valor do coeficiente a: \n");
	scanf("%d", &a);
	printf("Digite o valor do coeficiente b: \n");
	scanf("%d", &b);
	printf("Digite o valor do coeficiente c: \n");
	scanf("%d", &c);

	EqSegundoGrau(a, b, c, &y, &resp1, &resp2);
	printf("Valor de y: %d \n", y);
	printf("Valor de x1: %d \n", resp1);
	printf("Valor de x2: %d \n", resp2);
	
}
